@page "/budgets"
@using ContosoDashboard.Services
@using ContosoDashboard.Models
@using ContosoDashboard.Data
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@attribute [Authorize]
@inject IBudgetService BudgetService
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Presupuestos y Gastos - ContosoDashboard</PageTitle>

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col">
            <h2><i class="fas fa-wallet me-2"></i> Gestión de Presupuestos y Gastos</h2>
            <p class="text-muted">Solicite nuevos gastos para proyectos y gestione las aprobaciones pendientes.</p>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick="ToggleModal">
                <i class="fas fa-plus-circle me-1"></i> Nueva Solicitud de Gasto
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            @statusMessage
            <button type="button" class="btn-close" @onclick="() => statusMessage = string.Empty"></button>
        </div>
    }

    <!-- Tabla de Solicitudes -->
    <div class="card shadow-sm">
        <div class="card-header bg-light">
            <h5 class="mb-0">Solicitudes de Presupuesto Registradas</h5>
        </div>
        <div class="card-body">
            @if (requests == null)
            {
                <p class="text-center py-4">Cargando solicitudes...</p>
            }
            else if (!requests.Any())
            {
                <p class="text-center text-muted py-4">No hay solicitudes de presupuesto registradas.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Proyecto</th>
                                <th>Categoría</th>
                                <th>Monto</th>
                                <th>Justificación</th>
                                <th>Estado</th>
                                <th>Fecha</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var req in requests)
                            {
                                <tr>
                                    <td><strong>@(req.Project?.Name ?? $"Proyecto #{req.ProjectId}")</strong></td>
                                    <td><span class="badge bg-secondary">@req.Category</span></td>
                                    <td>$@req.Amount.ToString("N2")</td>
                                    <td>@req.Justification</td>
                                    <td>
                                        @if (req.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">Pendiente</span>
                                        }
                                        else if (req.Status == "Approved")
                                        {
                                            <span class="badge bg-success">Aprobado</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Rechazado</span>
                                        }
                                    </td>
                                    <td>@req.RequestDate.ToLocalTime().ToString("g")</td>
                                    <td>
                                        @if (req.Status == "Pending" && (isManager || isAdmin))
                                        {
                                            <button class="btn btn-sm btn-outline-success me-1" @onclick="() => Approve(req.Id)" title="Aprobar">
                                                <i class="fas fa-check"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => Reject(req.Id)" title="Rechazar">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">N/D</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal de Solicitud -->
@if (showModal)
{
    <div class="modal show fade d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Nueva Solicitud de Presupuesto</h5>
                    <button type="button" class="btn-close" @onclick="ToggleModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Proyecto *</label>
                        <select class="form-select" @bind="newProjectId">
                            <option value="0">Seleccione un proyecto...</option>
                            @foreach (var p in projects)
                            {
                                <option value="@p.ProjectId">@p.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Categoría *</label>
                        <select class="form-select" @bind="newCategory">
                            <option value="Viajes">Viajes</option>
                            <option value="Software">Software</option>
                            <option value="Hardware">Hardware</option>
                            <option value="Servicios">Servicios</option>
                            <option value="Otros">Otros</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Monto ($) *</label>
                        <input type="number" step="0.01" class="form-control" @bind="newAmount" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Justificación *</label>
                        <textarea class="form-control" @bind="newJustification" rows="3"></textarea>
                    </div>
                    @if (!string.IsNullOrEmpty(modalError))
                    {
                        <div class="text-danger small mt-1">@modalError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="ToggleModal">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="SubmitRequest">Enviar Solicitud</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<BudgetRequest>? requests;
    private List<Project> projects = new();
    private bool showModal = false;
    private string currentUserId = string.Empty;
    private bool isManager = false;
    private bool isAdmin = false;
    private string statusMessage = string.Empty;
    private string modalError = string.Empty;

    private int newProjectId = 0;
    private string newCategory = "Viajes";
    private decimal newAmount = 0;
    private string newJustification = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        currentUserId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "1";
        isAdmin = user.IsInRole("Administrator");
        isManager = user.IsInRole("ProjectManager") || isAdmin;

        projects = await DbContext.Projects.ToListAsync();
        await LoadRequests();
    }

    private async Task LoadRequests()
    {
        requests = await BudgetService.GetAllBudgetRequestsAsync();
    }

    private void ToggleModal()
    {
        showModal = !showModal;
        modalError = string.Empty;
        newProjectId = 0;
        newAmount = 0;
        newJustification = string.Empty;
    }

    private async Task SubmitRequest()
    {
        if (newProjectId == 0 || newAmount <= 0 || string.IsNullOrWhiteSpace(newJustification))
        {
            modalError = "Por favor complete todos los campos requeridos con valores válidos.";
            return;
        }

        try
        {
            await BudgetService.CreateBudgetRequestAsync(newProjectId, currentUserId, newAmount, newCategory, newJustification);
            statusMessage = "Solicitud de presupuesto enviada con éxito.";
            showModal = false;
            await LoadRequests();
        }
        catch (Exception ex)
        {
            modalError = $"Error al enviar solicitud: {ex.Message}";
        }
    }

    private async Task Approve(int id)
    {
        await BudgetService.ApproveBudgetRequestAsync(id, currentUserId, "Aprobado por gestión");
        statusMessage = "Solicitud aprobada correctamente.";
        await LoadRequests();
    }

    private async Task Reject(int id)
    {
        await BudgetService.RejectBudgetRequestAsync(id, currentUserId, "Rechazado por gestión");
        statusMessage = "Solicitud rechazada.";
        await LoadRequests();
    }
}
